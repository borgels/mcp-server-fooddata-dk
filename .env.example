# Open Food Facts requires a descriptive User-Agent (AppName/Version (contact)).
# No API key is needed for reads.
OFF_USER_AGENT=mcp-server-fooddata-dk/0.2.0 (you@example.com)
OFF_TIMEOUT_MS=15000

# Optional DTU Frida dataset (generic Danish foods). Defaults to ./data/frida.json.
# The server runs without it, serving Open Food Facts only.
FRIDA_DATA_PATH=./data/frida.json

# HTTP transport only. MCP_HTTP_TOKEN is the bearer required on every /mcp
# request (constant-time compare, at least 32 printable ASCII characters); it is
# required when MCP_HTTP_HOST is not a loopback address.
MCP_HTTP_HOST=127.0.0.1
PORT=3000
MCP_MAX_BODY_BYTES=10485760
MCP_ALLOWED_ORIGINS=
MCP_ALLOW_ANY_ORIGIN=false
MCP_ALLOWED_HOSTS=
MCP_HTTP_TOKEN=
MCP_HTTP_ALLOW_UNAUTHENTICATED=false
MCP_AUTH_FAILURE_LIMIT=20
MCP_AUTH_FAILURE_WINDOW_MS=60000
