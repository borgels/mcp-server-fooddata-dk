# Open Food Facts requires a descriptive User-Agent (AppName/Version (contact)).
# No API key is needed for reads.
OFF_USER_AGENT=mcp-server-fooddata-dk/0.1.0 (you@example.com)
OFF_TIMEOUT_MS=15000

# Optional DTU Frida dataset (generic Danish foods). Defaults to ./data/frida.json.
# The server runs without it, serving Open Food Facts only.
FRIDA_DATA_PATH=./data/frida.json

# HTTP transport only
MCP_HTTP_TOKEN=
